#include <stdio.h>

int main() 
{
    int t;
    scanf("%d",&t);
    
    while (t--) 
    {
        char s[1005];
       
        scanf(" %[^\n]",s);
        
        int count = 0;
        for (int i=0;s[i]!= '\0';i++)
            {
            char ch=s[i];
         
            if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u' ||
                ch == 'A' || ch == 'E' || ch == 'I' || ch == 'O' || ch == 'U')
                {
                count++;
            }
        }
        
        printf("Number of vowels = %d\n",count);
    }
    
    return 0;
}
