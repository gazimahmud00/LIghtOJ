#include <stdio.h>

int main()
{
    int T, n;
    scanf("%d", &T);

    for (int i = 0; i < T; i++)
    {
        scanf("%d", &n);

        int count = 0;

        while (n >= 5)
        {
            n = n/5;
            count = count+n;

        }
        printf("%d\n", count);
    }

    return 0;
}


