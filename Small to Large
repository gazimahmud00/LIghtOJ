#include<stdio.h>
int main()
{
    int T,n1,n2,n3,p,q,r;
    scanf("%d",&T);

    for(int i=1;i<=T;i++)
    {
        scanf("%d%d%d",&n1,&n2,&n3);
        if(n1>n2 && n1>n3)
        {
             p=n1;
            if(n2>n3)
            {
                q=n2;
                r=n3;
            }

            else
                {
                r=n2;
                q=n3;
            }


        }
        else if(n2>n1 && n2>n3)
        {
            p=n2;
            if(n1>n3)
            {
                q=n1;
                r=n3;
            }

            else
                {
                r=n1;
                q=n3;
            }


        }

       else if(n3>n1 && n3>n2)
        {
             p=n3;
            if(n1>n2)
            {
               q=n1;
               r=n2;
            }

            else
                {
                r=n1;
                q=n2;
            }


        }
        printf("Case %d: %d %d %d\n",i,r,q,p);

    }






    return 0;
}
