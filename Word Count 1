#include <stdio.h>

int main() 
{
    int t;
    scanf("%d", &t);
    
    while(t--) 
        {
        char s[10005];
        scanf(" %[^\n]",s);
        
        int count = 1; 
        
        for (int i = 0; s[i]!= '\0'; i++) 
        {
            
            if (s[i] == ' ') 
            {
                count++;
            }
        }
        
        
        printf("Count = %d\n", count);
    }
    
    return 0;
}
